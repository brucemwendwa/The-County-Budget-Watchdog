# Core app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gemini / Vertex AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro-latest
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Google Cloud — Document AI OCR (required for scanned/image PDFs)
# Use an OCR or Document OCR processor in Document AI.
GOOGLE_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=
GOOGLE_LOCATION=us
DOCUMENT_AI_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
DOCUMENT_AI_PROCESSOR_ID=
# Path to service account JSON file (local dev / Cloud Run)
GOOGLE_APPLICATION_CREDENTIALS=
# Or paste service account JSON inline (optional alternative)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Google Cloud Storage (PDF archive)
GCS_BUCKET=

# PostgreSQL / Supabase
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/budget_watchdog
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# BigQuery
BIGQUERY_DATASET=county_budget_watchdog

# Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Unlocks the paid pipeline (Document AI OCR, GCS archiving, database writes, real SMS delivery).
# Callers send it as the x-admin-api-key header. Without it the app still runs: uploads use the
# free pdf-parse path and SMS returns a preview, so no quota is spent by anonymous callers.
ADMIN_API_KEY=

# SMS
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
